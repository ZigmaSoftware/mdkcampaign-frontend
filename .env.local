# Backend API Configuration
VITE_API_BASE_URL=http://127.0.0.1:7904/api/v1
VITE_API_TIMEOUT=30000

# Optional: WebSocket URL for real-time updates
VITE_WS_URL=ws://127.0.0.1:7904/ws

# Frontend port (default: 8973). Override: VITE_PORT=5173 npm run dev
# VITE_PORT=8973

# Auth token storage keys (localStorage key names)
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
